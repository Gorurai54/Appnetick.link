        placeholder:
            "Example: Featured by..., interviewed by..., official organization page..."
    },

    {
        type: "confirm",

        key: "authenticityConfirmed",

        title: "Confirm account authenticity",

        text:
            "I confirm that this Appnetick account represents me, my organization, brand or entity described in this application."
    },

    {
        type: "confirm",

        key: "informationConfirmed",

        title: "Confirm your information",

        text:
            "I confirm that the information submitted in this verification application is accurate and complete to the best of my knowledge."
    },

    {
        type: "confirm",

        key: "termsConfirmed",

        title: "Verification declaration",

        text:
            "I understand that submitting this application does not guarantee verification. Appnetick may review the information provided and may approve or reject the request."
    },

    {
        type: "review"
    }

];


/* =========================================================
   CURRENT STEP
========================================================= */

let currentStep = 0;

let isAnimating = false;


/* =========================================================
   ELEMENTS
========================================================= */

const viewport =
    document.getElementById(
        "stepViewport"
    );

const progressFill =
    document.getElementById(
        "progressFill"
    );

const progressNumber =
    document.getElementById(
        "progressNumber"
    );

const backButton =
    document.getElementById(
        "backButton"
    );

const nextButton =
    document.getElementById(
        "nextButton"
    );

const nextText =
    document.getElementById(
        "nextText"
    );

const nextIcon =
    document.getElementById(
        "nextIcon"
    );


/* =========================================================
   RENDER
========================================================= */

function renderStep(
    direction = "next",
    animate = false
) {

    const step =
        steps[currentStep];

    const newElement =
        document.createElement("div");

    newElement.className =
        "step";

    newElement.innerHTML =
        getStepHTML(step);

    if (animate) {

        newElement.classList.add(
            direction === "next"
                ? "slide-next-enter"
                : "slide-back-enter"
        );
    }

    const oldElement =
        viewport.firstElementChild;

    if (oldElement && animate) {

        oldElement.classList.add(
            direction === "next"
                ? "slide-next-exit"
                : "slide-back-exit"
        );

        oldElement.addEventListener(
            "animationend",
            function () {

                if (oldElement.parentNode) {

                    oldElement.parentNode
                        .removeChild(oldElement);
                }

            },
            {
                once: true
            }
        );
    }

    viewport.appendChild(
        newElement
    );

    setTimeout(
        restoreFieldValue,
        0
    );

    updateProgress();

    updateButtons();
}


/* =========================================================
   STEP HTML
========================================================= */

function getStepHTML(step) {

    if (step.type === "intro") {

        return `

            <div class="intro-icon">
                <i class="ph ph-seal-check"></i>
            </div>

            <h1 class="step-title">
                Get the Appnetick verification badge
            </h1>

            <p class="step-description">
                Verification helps people recognize authentic accounts
                and makes it easier to identify the real person, creator,
                organization or brand behind an account.
            </p>

            <div class="intro-points">

                <div class="intro-point">

                    <div class="intro-point-icon">
                        <i class="ph ph-shield-check"></i>
                    </div>

                    <div class="intro-point-text">

                        <strong>Authenticity</strong>

                        We'll review the information you provide
                        to understand whether your account represents
                        a real identity or entity.

                    </div>

                </div>


                <div class="intro-point">

                    <div class="intro-point-icon">
                        <i class="ph ph-magnifying-glass"></i>
                    </div>

                    <div class="intro-point-text">

                        <strong>Public presence</strong>

