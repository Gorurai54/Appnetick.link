<style>

/* =========================================================
   ROOT
========================================================= */

:root {

    --bg: #FFFFFF;
    --surface: #FFFFFF;
    --surface-secondary: #F7F7F7;

    --text: #212121;
    --secondary: #757575;
    --muted: #9E9E9E;

    --border: #DCDCDC;

    --input-bg: #F5F5F5;

    --primary: #2196F3;
    --primary-soft: rgba(33,150,243,0.10);

    --danger: #E53935;

    --shadow:
        0 8px 30px rgba(0,0,0,0.06);

    --radius: 18px;
}

html[data-theme="dark"] {

    --bg: #1E1E1E;
    --surface: #1E1E1E;
    --surface-secondary: #252525;

    --text: #FFFFFF;
    --secondary: #A0A0A0;
    --muted: #777777;

    --border: #424242;

    --input-bg: #252525;

    --primary: #2979FF;
    --primary-soft: rgba(41,121,255,0.14);

    --danger: #EF5350;

    --shadow:
        0 8px 30px rgba(0,0,0,0.22);
}


/* =========================================================
   RESET
========================================================= */

* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
}

body {

    background: var(--bg);

    color: var(--text);

    font-family: Inter, sans-serif;

    overflow-x: hidden;

    transition:
        background 0.25s ease,
        color 0.25s ease;
}

button,
input,
textarea,
select {
    font-family: inherit;
}


/* =========================================================
   TOOLBAR
========================================================= */

.toolbar {

    height: 64px;

    width: 100%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 16px;

    position: sticky;

    top: 0;

    z-index: 100;

    background: var(--surface);

    border-bottom: 1px solid var(--border);
}

.brand {

    font-size: 20px;

    font-weight: 700;

    letter-spacing: -0.4px;
}

.toolbar-actions {

    display: flex;

    align-items: center;

    gap: 8px;
}

.icon-btn {

    width: 42px;

    height: 42px;

    border: 0;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    background: transparent;

    color: var(--text);

    cursor: pointer;

    font-size: 21px;

    transition:
        background 0.2s ease,
        transform 0.2s ease;
}

.icon-btn:hover {

    background: var(--surface-secondary);
}

.icon-btn:active {

    transform: scale(0.92);
}


/* =========================================================
   PAGE
========================================================= */

.page {

    width: 100%;

    max-width: 430px;

    margin: 0 auto;

    padding:
        26px
        20px
        36px;

    min-height:
        calc(100vh - 64px);

    display: flex;

    flex-direction: column;
}


/* =========================================================
   PROGRESS
========================================================= */

.progress-area {

    width: 100%;

    margin-bottom: 30px;
}

.progress-top {

    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 10px;
}

.progress-label {

    font-size: 13px;

    font-weight: 600;

    color: var(--secondary);
}

.progress-number {

    font-size: 13px;

    color: var(--muted);

    font-weight: 500;
}

.progress-track {

    width: 100%;

    height: 5px;

    border-radius: 999px;

    overflow: hidden;

    background: var(--surface-secondary);
}

.progress-fill {

    height: 100%;

    width: 5%;

    border-radius: inherit;

    background: var(--primary);

    transition:
        width 0.35s ease;
}


/* =========================================================
   STEP VIEWPORT
========================================================= */

.step-viewport {

    width: 100%;

    position: relative;

    overflow: hidden;

    flex: 1;
}

.step {

    width: 100%;

    animation-duration: 0.34s;

    animation-timing-function: cubic-bezier(
        0.22,
        1,
        0.36,
        1
    );

    animation-fill-mode: both;
}

.slide-next-enter {

    animation-name: slideNextEnter;
}

.slide-next-exit {

    animation-name: slideNextExit;
}

.slide-back-enter {

    animation-name: slideBackEnter;
}

.slide-back-exit {

    animation-name: slideBackExit;
}

@keyframes slideNextEnter {

    from {

        opacity: 0;

        transform:
            translate3d(100%,0,0);
    }

    to {

        opacity: 1;

        transform:
            translate3d(0,0,0);
    }
}

@keyframes slideNextExit {

    from {

        opacity: 1;

        transform:
            translate3d(0,0,0);
    }

    to {

        opacity: 0;

        transform:
            translate3d(-100%,0,0);
    }
}

@keyframes slideBackEnter {

    from {

        opacity: 0;

        transform:
            translate3d(-100%,0,0);
    }

    to {

        opacity: 1;

        transform:
            translate3d(0,0,0);
    }
}

@keyframes slideBackExit {

    from {

        opacity: 1;

        transform:
            translate3d(0,0,0);
    }

    to {

        opacity: 0;

        transform:
            translate3d(100%,0,0);
    }
}


/* =========================================================
   INTRO
========================================================= */

.intro-icon {

    width: 82px;

    height: 82px;

    border-radius: 25px;

    margin:
        10px
        auto
        24px;

    display: flex;

    align-items: center;

    justify-content: center;

    background: var(--primary-soft);

    color: var(--primary);

    font-size: 42px;
}

.step-title {

    margin: 0 0 10px;

    font-size: 25px;

    line-height: 1.22;

    font-weight: 700;

    letter-spacing: -0.5px;
}

.step-description {

    margin: 0;

    color: var(--secondary);

    font-size: 15px;

    line-height: 1.65;
}

.intro-points {

    margin-top: 28px;

    display: flex;

    flex-direction: column;

    gap: 12px;
}

.intro-point {

    display: flex;

    align-items: flex-start;

    gap: 12px;

    padding: 14px;

    border-radius: 16px;

    background: var(--surface-secondary);

    border: 1px solid var(--border);
}

.intro-point-icon {

    width: 36px;

    height: 36px;

    flex: 0 0 36px;

    border-radius: 11px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: var(--primary);

    background: var(--primary-soft);

    font-size: 19px;
}

.intro-point-text {

    font-size: 13px;

    line-height: 1.5;

    color: var(--secondary);
}

.intro-point-text strong {

    display: block;

    color: var(--text);

    margin-bottom: 3px;

    font-size: 14px;
}


/* =========================================================
   FORM
========================================================= */

.question-label {

    display: block;

    margin-top: 8px;

    margin-bottom: 9px;

    font-size: 20px;

    font-weight: 700;

    line-height: 1.35;

    letter-spacing: -0.25px;
}

.question-help {

    margin:
        0
        0
        22px;

    color: var(--secondary);

    font-size: 14px;

    line-height: 1.55;
}

.input-wrap {

    position: relative;

    width: 100%;
}

.input-icon {

    position: absolute;

    left: 16px;

    top: 50%;

    transform: translateY(-50%);

    color: var(--muted);

    font-size: 21px;

    pointer-events: none;
}

.form-input,
.form-select,
.form-textarea {

    width: 100%;

    border: 1px solid var(--border);

    outline: none;

    color: var(--text);

    background: var(--input-bg);

    border-radius: 16px;

    font-size: 15px;

    transition:
        border 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
}

.form-input,
.form-select {

    min-height: 54px;

    padding:
        0
        16px;
}

.form-input.with-icon,
.form-select.with-icon {

    padding-left: 50px;
}

.form-textarea {

    min-height: 135px;

    padding: 16px;

    resize: none;

    line-height: 1.55;
}

.form-input:focus,
.form-select:focus,
.form-textarea:focus {

    border-color: var(--primary);

    box-shadow:
        0 0 0 3px
        var(--primary-soft);
}

.form-input::placeholder,
.form-textarea::placeholder {

    color: var(--muted);
}


/* =========================================================
   CHIPS
========================================================= */

.chips {

    display: flex;

    flex-wrap: wrap;

    gap: 10px;
}

.chip {

    border: 1px solid var(--border);

    background: var(--surface);

    color: var(--secondary);

    border-radius: 999px;

    padding:
        11px
        15px;

    font-size: 13px;

    font-weight: 500;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border 0.2s ease,
        color 0.2s ease,
        transform 0.15s ease;
}

.chip:active {

    transform: scale(0.96);
}

.chip.selected {

    background: var(--primary-soft);

    color: var(--primary);

    border-color: var(--primary);
}


/* =========================================================
   INFO CARD
========================================================= */

.info-card {

    margin-top: 18px;

    padding: 14px;

    border-radius: 16px;

    background: var(--surface-secondary);

    border: 1px solid var(--border);

    display: flex;

    gap: 10px;

    align-items: flex-start;
}

.info-card i {

    color: var(--primary);

    font-size: 19px;

    margin-top: 1px;
}

.info-card span {

    color: var(--secondary);

    font-size: 12px;

    line-height: 1.55;
}


/* =========================================================
   CHECKBOX
========================================================= */

.confirm-box {

    padding: 17px;

    border-radius: 17px;

    border: 1px solid var(--border);

    background: var(--surface-secondary);

    cursor: pointer;
}

.confirm-row {

    display: flex;

    align-items: flex-start;

    gap: 12px;
}

.custom-check {

    width: 22px;

    height: 22px;

    flex: 0 0 22px;

    border-radius: 7px;

    border: 1.5px solid var(--muted);

    display: flex;

    align-items: center;

    justify-content: center;

    color: #FFFFFF;

    font-size: 15px;

    margin-top: 1px;
}

.confirm-box.checked .custom-check {

    border-color: var(--primary);

    background: var(--primary);
}

.confirm-text {

    color: var(--secondary);

    font-size: 13px;

    line-height: 1.55;
}


/* =========================================================
   REVIEW
========================================================= */

.review-card {

    border: 1px solid var(--border);

    background: var(--surface-secondary);

    border-radius: 18px;

    overflow: hidden;
}

.review-row {

    padding:
        14px
        15px;

    border-bottom:
        1px solid var(--border);
}

.review-row:last-child {

    border-bottom: 0;
}

.review-label {

    font-size: 11px;

    color: var(--muted);

    margin-bottom: 4px;

    text-transform: uppercase;

    letter-spacing: 0.5px;

    font-weight: 600;
}

.review-value {

    font-size: 14px;

    color: var(--text);

    line-height: 1.45;

    word-break: break-word;
}


/* =========================================================
   BOTTOM NAV
========================================================= */

.bottom-actions {

    width: 100%;

    margin-top: 30px;

    display: flex;

    gap: 10px;
}

.back-button {

    width: 54px;

    height: 54px;

    flex: 0 0 54px;

    border: 1px solid var(--border);

    background: var(--surface);

    color: var(--text);

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 21px;

    cursor: pointer;
}

.next-button {

    height: 54px;

    flex: 1;

    border: 0;

    border-radius: 999px;

    background: var(--primary);

    color: #FFFFFF;

    font-size: 15px;

    font-weight: 600;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    cursor: pointer;

    box-shadow:
        0 7px 18px
        rgba(33,150,243,0.18);

    transition:
        transform 0.15s ease,
        opacity 0.2s ease;
}

.next-button:active {

    transform: scale(0.98);
}

.next-button:disabled {

    opacity: 0.5;

    cursor: not-allowed;

    box-shadow: none;
}


/* =========================================================
   SUCCESS
========================================================= */

.success {

    text-align: center;

    padding-top: 35px;
}

.success-icon {

    width: 86px;

    height: 86px;

    margin: 0 auto 24px;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    color: var(--primary);

    background: var(--primary-soft);

    font-size: 44px;
}

.success h2 {

    margin: 0 0 10px;

    font-size: 25px;
}

.success p {

    margin: 0;

    color: var(--secondary);

    font-size: 14px;

    line-height: 1.65;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 360px) {

    .page {

        padding-left: 16px;

        padding-right: 16px;
    }

    .step-title {

        font-size: 23px;
    }

    .question-label {

        font-size: 19px;
    }
}

</style>
</head>


<body>

<!-- =======================================================
     TOOLBAR
======================================================== -->

<header class="toolbar">

    <div class="brand">
        Appnetick.
    </div>

    <div class="toolbar-actions">

        <button
            class="icon-btn"
            id="themeButton"
            type="button"
            aria-label="Change theme"
        >
            <i class="ph ph-moon"></i>
        </button>

        <button
            class="icon-btn"
            type="button"
            onclick="goHome()"
            aria-label="Home"
        >
            <i class="ph ph-house"></i>
        </button>

    </div>

</header>


<!-- =======================================================
     PAGE
======================================================== -->

<main class="page">

    <!-- PROGRESS -->

    <div class="progress-area">

        <div class="progress-top">

            <span
                class="progress-label"
                id="progressLabel"
            >
                Verification
            </span>

            <span
                class="progress-number"
                id="progressNumber"
            >
                1 of 20
            </span>

        </div>

        <div class="progress-track">

            <div
                class="progress-fill"
                id="progressFill"
            ></div>

        </div>

