                        <i class="ph ph-check"></i>
                    </div>

                    <div class="confirm-text">
                        ${step.text}
                    </div>

                </div>

            </div>

        `;
    }


    if (step.type === "review") {

        return getReviewHTML();
    }


    return "";
}


/* =========================================================
   CHIP SELECT
========================================================= */

function selectChip(element) {

    const all =
        document.querySelectorAll(
            ".chip"
        );

    all.forEach(
        chip =>
            chip.classList.remove(
                "selected"
            )
    );

    element.classList.add(
        "selected"
    );

    formData[
        steps[currentStep].key
    ] =
        element.dataset.value;

    updateButtons();
}


/* =========================================================
   CONFIRM
========================================================= */

function toggleConfirm() {

    const box =
        document.getElementById(
            "confirmBox"
        );

    if (!box) return;

    const key =
        steps[currentStep].key;

    formData[key] =
        !formData[key];

    box.classList.toggle(
        "checked",
        formData[key]
    );

    updateButtons();
}


/* =========================================================
   SAVE CURRENT FIELD
========================================================= */

function saveCurrentValue() {

    const step =
        steps[currentStep];

    if (
        step.type === "input" ||
        step.type === "date" ||
        step.type === "textarea"
    ) {

        const input =
            document.getElementById(
                "currentInput"
            );

        if (input) {

            formData[step.key] =
                input.value.trim();
        }
    }
}


/* =========================================================
   RESTORE FIELD
========================================================= */

function restoreFieldValue() {

    const step =
        steps[currentStep];

    if (
        step.type === "input" ||
        step.type === "date" ||
        step.type === "textarea"
    ) {

        const input =
            document.getElementById(
                "currentInput"
            );

        if (
            input &&
            formData[step.key]
        ) {

            input.value =
                formData[step.key];
        }
    }


    if (step.type === "chips") {

        const selected =
            formData[step.key];

        if (!selected) return;

        document
            .querySelectorAll(".chip")
            .forEach(
                chip => {

                    if (
                        chip.dataset.value ===
                        selected
                    ) {

                        chip.classList.add(
                            "selected"
                        );
                    }
                }
            );
    }


    if (step.type === "confirm") {

        const box =
            document.getElementById(
                "confirmBox"
            );

        if (
            box &&
            formData[step.key]
        ) {

            box.classList.add(
                "checked"
            );
        }
    }
}


/* =========================================================
   VALIDATION
========================================================= */

function validateCurrentStep() {

    const step =
        steps[currentStep];

    if (step.type === "intro") {

        return true;
    }


    if (
        step.type === "input" ||
        step.type === "date" ||
        step.type === "textarea"
    ) {

        saveCurrentValue();

        if (
            !formData[step.key] &&
            !step.optional
        ) {

            showError(
                "Please enter this information before continuing."
            );

            return false;
        }
    }


    if (step.type === "chips") {

        if (
            !formData[step.key]
        ) {

            showError(
                "Please select one option to continue."
            );

            return false;
        }
    }


    if (step.type === "confirm") {

        if (
            !formData[step.key]
        ) {

            showError(
                "Please confirm this before continuing."
            );

            return false;
        }
    }


    return true;
}


/* =========================================================
   NEXT
========================================================= */

function nextStep() {

    if (isAnimating) return;

    if (!validateCurrentStep()) {
        return;
    }

    if (
        currentStep >=
        steps.length - 1
    ) {

        submitVerification();

        return;
    }

    isAnimating = true;

    currentStep++;

    renderStep(
        "next",
        true
    );

    setTimeout(
        () => {
            isAnimating = false;
        },
        350
    );

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}


/* =========================================================
   BACK
========================================================= */

function previousStep() {

    if (isAnimating) return;

    if (currentStep <= 0) {

        goHome();

        return;
    }

    saveCurrentValue();

    isAnimating = true;

    currentStep--;

    renderStep(
        "back",
        true
    );

    setTimeout(
        () => {
            isAnimating = false;
        },
        350
    );
}


/* =========================================================
   PROGRESS
========================================================= */

function updateProgress() {

    const total =
        steps.length;

    const number =
        currentStep + 1;

    const percentage =
        (number / total) * 100;

    progressNumber.textContent =
        `${number} of ${total}`;

    progressFill.style.width =
        `${percentage}%`;

    if (
        currentStep === 0
    ) {

        document.getElementById(
            "progressLabel"
        ).textContent =
            "Verification";

    } else if (
        currentStep === total - 1
    ) {

        document.getElementById(
            "progressLabel"
        ).textContent =
            "Review";

    } else {

        document.getElementById(
            "progressLabel"
        ).textContent =
            "Application";
    }
}


/* =========================================================
   BUTTONS
========================================================= */

function updateButtons() {

    if (
        currentStep === 0
    ) {

        backButton.style.visibility =
            "hidden";

        nextText.textContent =
            "Get started";

        nextIcon.className =
            "ph ph-arrow-right";

        nextButton.disabled =
            false;

        return;
    }


    backButton.style.visibility =
        "visible";


    if (
        currentStep ===
        steps.length - 1
    ) {

        nextText.textContent =
            "Submit application";

        nextIcon.className =
            "ph ph-paper-plane-tilt";

    } else {

        nextText.textContent =
            "Next";

        nextIcon.className =
            "ph ph-arrow-right";
    }
}


