        help:
            "Provide one public social profile or professional page that represents you.",

        icon: "ph-link",

        placeholder:
            "https://..."
    },

    {
        type: "chips",

        key: "audience",

        title: "What is your approximate audience size?",

        help:
            "Choose the closest range. Exact numbers are not required.",

        options: [

            "Under 1K",
            "1K – 10K",
            "10K – 50K",
            "50K – 100K",
            "100K – 500K",
            "500K – 1M",
            "1M+"
        ]
    },

    {
        type: "chips",

        key: "contentCategory",

        title: "What type of content do you primarily share?",

        help:
            "Select the category that best describes your public activity.",

        options: [

            "Education",
            "Entertainment",
            "Technology",
            "Music",
            "Fashion",
            "Sports",
            "News",
            "Business",
