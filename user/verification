                        your public presence and identity.

                    </div>

                </div>


                <div class="intro-point">

                    <div class="intro-point-icon">
                        <i class="ph ph-lock-key"></i>
                    </div>

                    <div class="intro-point-text">

                        <strong>Security review</strong>

                        Your application is reviewed separately from
                        your normal Appnetick profile information.

                    </div>

                </div>

            </div>

        `;
    }


    if (step.type === "input") {

        return `

            <label class="question-label">
                ${step.title}
            </label>

            <p class="question-help">
                ${step.help}
            </p>

            <div class="input-wrap">

                <i class="ph ${step.icon} input-icon"></i>

                <input
                    class="form-input with-icon"
                    id="currentInput"
                    type="${step.inputType || "text"}"
                    placeholder="${step.placeholder || ""}"
                    autocomplete="off"
                    ${step.optional ? "" : "required"}
                >

            </div>

            ${
                step.optional
                    ? `
                        <div class="info-card">

                            <i class="ph ph-info"></i>

                            <span>
                                This field is optional. You can continue
                                without adding a website.
                            </span>

                        </div>
                    `
                    : ""
            }

        `;
    }


    if (step.type === "date") {

        return `

            <label class="question-label">
                ${step.title}
            </label>

            <p class="question-help">
                ${step.help}
            </p>

            <div class="input-wrap">

                <i class="ph ${step.icon} input-icon"></i>

                <input
                    class="form-input with-icon"
                    id="currentInput"
                    type="date"
                >

            </div>

        `;
    }


    if (step.type === "textarea") {

        return `

            <label class="question-label">
                ${step.title}
            </label>

            <p class="question-help">
                ${step.help}
            </p>

            <textarea
                class="form-textarea"
                id="currentInput"
                placeholder="${step.placeholder || ""}"
                maxlength="1000"
            ></textarea>

        `;
    }


    if (step.type === "chips") {

        return `

            <label class="question-label">
                ${step.title}
            </label>

            <p class="question-help">
                ${step.help}
            </p>

            <div class="chips">

                ${
                    step.options.map(
                        option => `

                            <button
                                type="button"
                                class="chip"
                                data-value="${escapeHTML(option)}"
                                onclick="selectChip(this)"
                            >
                                ${escapeHTML(option)}
                            </button>

                        `
                    ).join("")
                }

            </div>

        `;
    }


    if (step.type === "confirm") {

        return `

            <label class="question-label">
                ${step.title}
            </label>

            <p class="question-help">
                Please read this confirmation carefully before continuing.
            </p>

            <div
                class="confirm-box"
                id="confirmBox"
                onclick="toggleConfirm()"
            >

                <div class="confirm-row">

                    <div
