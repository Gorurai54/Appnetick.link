        title: "What is your phone number?",

        help:
            "Use a phone number that you control. It may be used for account security checks.",

        icon: "ph-phone",

        placeholder:
            "+91 XXXXX XXXXX",

        inputType:
            "tel"
    },

    {
        type: "chips",

        key: "accountCategory",

        title: "What best describes your account?",

        help:
            "Choose the category that most accurately represents your public presence.",

        options: [

            "Creator",
            "Public Figure",
            "Artist",
            "Musician",
            "Business",
            "Brand",
            "Professional",
            "Organization",
            "Community",
            "Other"
        ]
    },

    {
        type: "input",

        key: "profession",

        title: "What is your profession or role?",

        help:
            "Tell us what you currently do publicly or professionally.",

        icon: "ph-briefcase",

        placeholder:
            "Example: Photographer"
    },

    {
        type: "textarea",

        key: "verificationReason",

        title: "Why should this account be verified?",

        help:
            "Explain why people may search for or recognize you, your organization, brand or work.",

        placeholder:
            "Tell us why this account deserves verification..."
    },

    {
