/* =========================================================
   ERROR
========================================================= */

function showError(message) {

    let existing =
        document.getElementById(
            "formError"
        );

    if (existing) {

        existing.remove();
    }

    const error =
        document.createElement(
            "div"
        );

    error.id =
        "formError";

    error.style.cssText = `

        margin-top:14px;
        padding:12px 14px;
        border-radius:14px;
        background:rgba(229,57,53,0.10);
        border:1px solid rgba(229,57,53,0.25);
        color:var(--danger);
        font-size:13px;
        line-height:1.45;

    `;

    error.innerHTML = `

        <i class="ph ph-warning-circle"></i>
        ${escapeHTML(message)}

    `;

    viewport
        .firstElementChild
        ?.appendChild(error);

    setTimeout(
        () => {

            if (error.parentNode) {

                error.remove();
            }

        },
        3000
    );
}


/* =========================================================
   USER DATA
========================================================= */

/*
   Your existing Users/{uid} data can be supplied
   to this page from your authentication/session API.

   Example expected object:

   {
       uid: "...",
       Username: "...",
       email: "...",
       full_name: "..."
   }
*/

function setUserData(user) {

    if (!user) return;

    formData.uid =
        user.uid || "";

    formData.username =
        user.Username || "";

    formData.fullName =
        user.full_name || "";

    formData.email =
        user.email || "";
}


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHTML(value) {

    return String(
        value ?? ""
    )
    .replace(
        /&/g,
        "&amp;"
    )
    .replace(
        /</g,
        "&lt;"
    )
    .replace(
        />/g,
        "&gt;"
    )
    .replace(
        /"/g,
        "&quot;"
    )
    .replace(
        /'/g,
        "&#039;"
    );
}


/* =========================================================
   HOME
========================================================= */

function goHome() {

    window.location.href =
        "/";
}


/* =========================================================
   INITIALIZE
========================================================= */

