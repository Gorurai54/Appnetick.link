</main>


<script>

/* =========================================================
   FIREBASE CONFIG
   Only used to identify the logged-in user's existing
   information if supplied by your backend/session.
========================================================= */

const API_BASE =
    "https://api-appnetick.vercel.app";


/* =========================================================
   THEME
========================================================= */

const savedTheme =
    localStorage.getItem("appnetick-theme");

if (savedTheme === "dark") {

    document.documentElement
        .setAttribute(
            "data-theme",
            "dark"
        );
}

function updateThemeIcon() {

    const button =
        document.getElementById("themeButton");

    const icon =
        button.querySelector("i");

    const isDark =
        document.documentElement
            .getAttribute("data-theme") === "dark";

    icon.className =
        isDark
            ? "ph ph-sun"
            : "ph ph-moon";
}

updateThemeIcon();


document
    .getElementById("themeButton")
    .addEventListener(
        "click",
        function () {

            const isDark =
                document.documentElement
                    .getAttribute("data-theme") === "dark";

            if (isDark) {

                document.documentElement
                    .removeAttribute("data-theme");

                localStorage
                    .setItem(
                        "appnetick-theme",
                        "light"
                    );

            } else {

                document.documentElement
                    .setAttribute(
                        "data-theme",
                        "dark"
                    );

                localStorage
                    .setItem(
                        "appnetick-theme",
                        "dark"
                    );
            }

            updateThemeIcon();
        }
    );


/* =========================================================
   FORM DATA
========================================================= */

const formData = {

    uid: "",
    username: "",
    fullName: "",
    email: "",

    legalName: "",
    dateOfBirth: "",

    country: "",
    phone: "",

    accountCategory: "",
    profession: "",

    verificationReason: "",
    knownFor: "",

    website: "",
    socialProfile: "",

    audience: "",
    contentCategory: "",

    achievement: "",
    publicPresence: "",

    authenticityConfirmed: false,
    informationConfirmed: false,
    termsConfirmed: false
};


/* =========================================================
   STEP DEFINITIONS
========================================================= */

const steps = [

    {
        type: "intro"
    },

    {
        type: "input",

        key: "legalName",

        title: "What is your legal name?",

        help:
            "Enter your full legal name exactly as it appears on your official records.",

        icon: "ph-user",

        placeholder:
            "Enter your legal name"
    },

    {
        type: "input",

        key: "username",

        title: "Confirm your username",

        help:
            "This is the Appnetick username associated with the account you want to verify.",

        icon: "ph-at",

        placeholder:
            "@username"
    },

    {
        type: "date",

        key: "dateOfBirth",

        title: "What is your date of birth?",

        help:
            "Your date of birth helps us establish that the account belongs to a real person.",

        icon: "ph-calendar-blank"
    },

    {
        type: "chips",

        key: "country",

